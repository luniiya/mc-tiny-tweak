{
  "schemaVersion": 1,
  "id": "mc_tiny_tweak",
  "version": "${version}",
  "name": "MC Tiny Tweak",
  "description": "My opinionated Minecraft tweaks in one place.",
  "authors": ["luniiya"],
  "contact": {
    "sources": "https://github.com/luniiya/mc-tiny-tweak",
    "issues": "https://github.com/luniiya/mc-tiny-tweak/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [{"adapter": "kotlin", "value": "dev.luniiya.mctinytweak.McTinyTweak"}],
    "client": [{"adapter": "kotlin", "value": "dev.luniiya.mctinytweak.client.McTinyTweakClient"}],
    "preLaunch": [{"adapter": "kotlin", "value": "dev.luniiya.mctinytweak.McTinyTweakPreLaunch"}]
  },
  "mixins": ["mc-tiny-tweak.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  }
}
